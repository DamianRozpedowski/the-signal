# Copy to .env (or set in your host's environment). Only PORT/DATA_DIR are needed to run;
# everything else unlocks an optional feature and the UI shows a clear notice when it is missing.

PORT=8787
DATA_DIR=./data
# DATABASE_PATH=./data/daily-wire.db
# Public address of the app, used in email/push links
PUBLIC_URL=http://localhost:8787

# Accounts: the first account becomes administrator. Set to 1 to let others sign up.
ALLOW_SIGNUP=0

# AI (summaries, briefings prose, coverage comparison, Q&A, weekly recap)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_ARTICLE_MODEL=claude-opus-5-5   # model for per-article summaries
# AI_DAILY_ARTICLE_SUMMARY_LIMIT=400 # cap on article summaries per day
# AI_FALLBACKS=1                     # server-side model fallback (set 0 to disable)
# AI_DISABLED=1                      # turn AI off even with a key present

# Email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push alerts (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Ingestion tuning
# INGEST_CONCURRENCY=4
# FETCH_TIMEOUT_MS=15000
# MAX_FEED_BYTES=5242880
# MIN_HOST_INTERVAL_MS=2000
# FEED_USER_AGENT=TheSignal/0.1 (+your contact URL)
# DISABLE_SCHEDULER=1     # stop automatic fetching (tests, maintenance)
# ALLOW_PRIVATE_FEEDS=1   # allow localhost/private-network feeds (development only; disables SSRF guard)
# HTTPS_PROXY=...         # honored for outbound feed and API requests
